---
import ContrastChecker from '~/components/ui/ContrastChecker.astro'
import DefaultLayout from '~/layouts/DefaultLayout.astro'
import PageHeader from '~/components/ui/PageHeader.astro'
---

<DefaultLayout
  title="Verificador de contraste"
  description="Ferramenta para verificar contraste de texto e elementos não textuais segundo critérios da WCAG."
>
  <section class="my-12">
    <PageHeader
      title="Verificador de contraste"
      subtitle="Compare duas cores para avaliar texto nos níveis <strong>AA</strong> e <strong>AAA</strong> e elementos não textuais no nível <strong>AA</strong>."
      bgType="bordered"
      customBreadcrumbLabels={{ ferramentas: 'Ferramentas', contraste: 'Contraste' }}
    />
  </section>

  <section class="container my-16">
    <div class="tool-intro">
      <p>
        A ferramenta calcula a taxa entre as cores informadas. Para componentes e objetos gráficos, confirme se a parte
        visual é necessária e se as cores são realmente adjacentes antes de aplicar o resultado.
      </p>
    </div>
    <ContrastChecker />
  </section>
</DefaultLayout>

<style>
  .tool-intro {
    max-inline-size: 75ch;
    margin-block-end: var(--space-l);
  }
</style>
